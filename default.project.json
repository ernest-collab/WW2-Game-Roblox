{
  "name": "WW2-Frontlines",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": { "$path": "src/shared" }
    },
    "ServerScriptService": {
      "Server": { "$path": "src/server" }
    },
    "StarterPlayer": {
      "$properties": {
        "CameraMaxZoomDistance": 12,
        "CharacterWalkSpeed": 14,
        "CharacterJumpHeight": 5,
        "LoadCharacterAppearance": false
      },
      "StarterPlayerScripts": {
        "Client": { "$path": "src/client" }
      }
    },
    "Players": {
      "$properties": { "CharacterAutoLoads": false, "RespawnTime": 5 }
    },
    "Lighting": {
      "$properties": {
        "Technology": "Future",
        "GlobalShadows": true,
        "Brightness": 2,
        "EnvironmentDiffuseScale": 1,
        "EnvironmentSpecularScale": 1
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": true,
        "StreamingTargetRadius": 1024,
        "StreamingMinRadius": 256,
        "StreamingIntegrityMode": "MinimumRadiusPause",
        "Gravity": 196.2
      }
    },
    "SoundService": {
      "$properties": { "RespectFilteringEnabled": true }
    },
    "Teams": { "$className": "Teams" }
  }
}
